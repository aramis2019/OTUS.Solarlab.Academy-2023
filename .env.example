# Скопируйте в .env и задайте свои значения: cp .env.example .env
# Пароль пользователя postgres. Для локальной разработки совпадает с appsettings.Development.json.
POSTGRES_PASSWORD=password
# Ключ подписи JWT, минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_KEY=
# Лицензионный ключ AutoMapper (https://automapper.io). Без него API работает, но пишет предупреждение в лог.
AUTOMAPPER_LICENSE_KEY=
